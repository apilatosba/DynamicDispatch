//
// use like this:
// main :: () {
//    Initialize();
//    work := DispatchFunction(MyFunction, p1, p2, ...); // where p1, p2 ... are parameters to MyFunction
//    ...
//    if IsWorkDone(work) { ... }
//    WaitForWork(work);
// }
//
// the WorkHandle returned by DispatchFunction is a work id. pass it to IsWorkDone / WaitForWork or do equality checks.
// a handle stays valid forever, after the work is done IsWorkDone keeps returning true. 0 is never a valid handle.
//
// if your function takes *Thread as its first parameter, dont provide it. it will be filled by this library.
//

//
// the number of threads is dynamic.
// DispatchFunction gives the work to an idle thread if there is one, otherwise it creates a new thread.
// so a dispatched function never waits in a queue, it starts running immediately.
//
// a thread that finishes its work becomes idle and is reused by a later DispatchFunction call, so the number of threads
// is the maximum number of works that were running at the same time.
// if a spike created a lot of threads that you dont need anymore call TruncateThreads to get rid of the idle ones.
//
// after Initialize every function of this library can be called from any thread, including from a dispatched function.
//

#import "Thread";
#import "Basic";

WorkHandle :: u64;

Initialize :: () {
   init(*dispatcher.mutex, "DynamicDispatch");

   // these are modified from whatever thread calls into the library, so dont let them pick up the caller's context.allocator
   dispatcher.workers.allocator      = context.default_allocator;
   dispatcher.idleWorkers.allocator  = context.default_allocator;
   dispatcher.waiters.allocator      = context.default_allocator;
}

IsWorkDone :: (work: WorkHandle) -> bool {
   lock(*dispatcher.mutex);
   done := IsWorkDoneLocked(work);
   unlock(*dispatcher.mutex);

   return done;
}

// timeout is in milliseconds, -1 waits forever.
// returns true if the work is done, false if timed out.
WaitForWork :: (work: WorkHandle, timeout: int = -1) -> bool {
   waiter: Waiter;
   waiter.work = work;

   lock(*dispatcher.mutex);
   if (IsWorkDoneLocked(waiter.work)) {
      unlock(*dispatcher.mutex);
      return true;
   }
   init(*waiter.semaphore);
   array_add(*dispatcher.waiters, *waiter);
   unlock(*dispatcher.mutex);

   defer destroy(*waiter.semaphore);

   if (wait_for(*waiter.semaphore, cast(s32) timeout) == .SUCCESS) return true;

   // timed out. but the work might have completed right after the timeout.
   // if the worker already removed us from the waiters then the work is done.
   lock(*dispatcher.mutex);
   removed := array_unordered_remove_by_value(*dispatcher.waiters, *waiter, stop_after_first = true);
   unlock(*dispatcher.mutex);

   return removed == 0;
}

// destroys every thread that is idle at the moment. busy threads are left alone.
TruncateThreads :: () {
   idleWorkers: [..] *Worker;
   idleWorkers.allocator = temp;

   lock(*dispatcher.mutex);
   array_copy(*idleWorkers, dispatcher.idleWorkers);
   for idleWorkers {
      array_unordered_remove_by_value(*dispatcher.workers, it, stop_after_first = true);
   }
   dispatcher.idleWorkers.count = 0;
   unlock(*dispatcher.mutex);

   // a null work tells the worker to quit
   for idleWorkers {
      it.work = null;
      signal(*it.semaphore);
   }

   for idleWorkers {
      thread_deinit(*it.thread); // waits for the thread to exit
      destroy(*it.semaphore);
      free(it,, context.default_allocator);
   }
}

// generate DispatchFunction overloads
#insert #run () -> string {
   builder: String_Builder;
   for 0..9 {
      s: string;

      s = GenerateDispatchFunctionWithoutThread(it);
      print_to_builder(*builder, s);

      s = GenerateDispatchFunctionWithThread(it);
      print_to_builder(*builder, s);

      s = GenerateDispatchFunctionNoParameterMissing(it);
      print_to_builder(*builder, s);

      if (it >= 1) {
         s = GenerateDispatchFunctionOneParameterMissing(it);
         print_to_builder(*builder, s);
      }
   }

   return builder_to_string(*builder);
}();



#scope_module

// every work struct generated by DispatchFunction has this as its first field.
// works are allocated with context.default_allocator since they are allocated on the dispatching thread but freed on the worker thread.
WorkHeader :: struct {
   execute: #type (thread: *Thread, work: *WorkHeader);
}

Worker :: struct {
   thread:     Thread;
   semaphore:  Semaphore;      // signaled when work is assigned (or when the worker should quit)
   work:       *WorkHeader;    // null means quit
   workHandle: WorkHandle;     // handle of the work being executed, 0 if idle. protected by dispatcher.mutex
}

// a thread waiting in WaitForWork
Waiter :: struct {
   work:       WorkHandle;
   semaphore:  Semaphore;
}

Dispatcher :: struct {
   mutex:            Mutex;            // protects everything below
   nextWorkHandle:   WorkHandle = 1;   // 0 is never a valid work handle
   workers:          [..] *Worker;     // busy + idle
   idleWorkers:      [..] *Worker;
   waiters:          [..] *Waiter;
}

dispatcher: Dispatcher;

AddWork :: (work: *WorkHeader) -> WorkHandle {
   worker: *Worker;

   lock(*dispatcher.mutex);
   if (dispatcher.idleWorkers.count > 0) {
      worker = pop(*dispatcher.idleWorkers);
   } else {
      worker = CreateWorker();
   }

   handle := dispatcher.nextWorkHandle;
   dispatcher.nextWorkHandle += 1;
   worker.workHandle = handle;
   unlock(*dispatcher.mutex);

   worker.work = work;
   signal(*worker.semaphore);

   return handle;
}

// dispatcher.mutex must be locked
IsWorkDoneLocked :: (work: WorkHandle) -> bool {
   assert(work != 0 && work < dispatcher.nextWorkHandle, "invalid work handle");

   for dispatcher.workers {
      if (it.workHandle == work) return false;
   }

   return true;
}

// dispatcher.mutex must be locked
CreateWorker :: () -> *Worker {
   WorkerProc :: (thread: *Thread) -> s64 {
      worker := cast(*Worker) thread.data;

      while true {
         wait_for(*worker.semaphore);

         work := worker.work;
         if (work == null) break;

         work.execute(thread, work);
         free(work,, context.default_allocator);

         lock(*dispatcher.mutex);
         for waiter: dispatcher.waiters {
            if (waiter.work == worker.workHandle) {
               signal(*waiter.semaphore);
               remove waiter;
            }
         }
         worker.workHandle = 0;
         array_add(*dispatcher.idleWorkers, worker);
         unlock(*dispatcher.mutex);
      }

      return 0;
   }

   worker := New(Worker,, context.default_allocator);
   init(*worker.semaphore);

   // thread_init gives the thread the current context.allocator and allocates its temporary storage with it
   name := tprint("DynamicDispatch Worker %", dispatcher.workers.count);
   success := thread_init(*worker.thread, WorkerProc, name = name,, allocator = context.default_allocator);
   assert(success, "failed to create a thread");

   worker.thread.data = worker;
   thread_start(*worker.thread);

   array_add(*dispatcher.workers, worker);

   return worker;
}

GenerateDispatchFunctionNoParameterMissing :: (parameterCount: int) -> string {
   b: String_Builder;

   print_to_builder(*b, "DispatchFunction :: (function: #type (");

   if (parameterCount > 0) {
      for 0..parameterCount - 2 {
         print_to_builder(*b, "_: $T%, ", it);
      }
      print_to_builder(*b, "_: $T%", parameterCount - 1);
   }

   print_to_builder(*b, ") -> ()");

   for 0..parameterCount - 1 {
      print_to_builder(*b, ", p%1: T%1", it);
   }

   print_to_builder(*b, ") -> WorkHandle {\n");

   print_to_builder(*b, "   return DispatchFunctionWithoutThread(function");

   for 0..parameterCount - 1 {
      print_to_builder(*b, ", p%", it);
   }
   print_to_builder(*b, ");\n");

   print_to_builder(*b, "}\n");

   return builder_to_string(*b);
}

GenerateDispatchFunctionOneParameterMissing :: (parameterCount: int) -> string {
   assert(parameterCount >= 1, "if there is no parameter, it cant be missing");

   b: String_Builder;

   print_to_builder(*b, "DispatchFunction :: (function: #type (");

   for 0..parameterCount - 2 {
      print_to_builder(*b, "_: $T%, ", it);
   }
   print_to_builder(*b, "_: $T%", parameterCount - 1);

   print_to_builder(*b, ") -> ()");

   // starts from 1 instead of 0 (one parameter missing as requested)
   for 1..parameterCount - 1 {
      print_to_builder(*b, ", p%1: T%1", it);
   }

   print_to_builder(*b, ") -> WorkHandle {\n");

   print_to_builder(*b, "   #assert T0 == *Thread \"one parameter was not provided and your function doesnt take *Thread as its first parameter. Maybe you forgot to provide an argument?\";\n");

   print_to_builder(*b, "   return DispatchFunctionWithThread(function");

   for 1..parameterCount - 1 {
      print_to_builder(*b, ", p%", it);
   }
   print_to_builder(*b, ");\n");

   print_to_builder(*b, "}\n");

   return builder_to_string(*b);
}

GenerateDispatchFunctionWithThread :: (parameterCount: int) -> string {
   b: String_Builder;
   print_to_builder(*b, "DispatchFunctionWithThread :: (function: #type (thread: *Thread");

   for 0.. parameterCount - 1 {
      print_to_builder(*b, ", _: $T%", it);
   }

   print_to_builder(*b, ") -> ()");

   for 0..parameterCount - 1 {
      print_to_builder(*b, ", p%1: T%1", it);
   }

   print_to_builder(*b, ") -> WorkHandle {\n");

   print_to_builder(*b,"   Work :: struct {\n");
   print_to_builder(*b,"      header: WorkHeader;\n");
   print_to_builder(*b,"      function: #type (*Thread");

   for 0..parameterCount - 1 {
      print_to_builder(*b, ", T%", it);
   }

   print_to_builder(*b, ") -> ();\n");

   for 0..parameterCount - 1 {
      print_to_builder(*b, "      f%1: T%1;\n", it);
   }

   print_to_builder(*b, "\n");
   print_to_builder(*b, "      WorkExecuteFunction :: (thread: *Thread, header: *WorkHeader) {\n");
   print_to_builder(*b, "         work := cast(*Work) header;\n");
   print_to_builder(*b, "         work.function(thread");

   for 0..parameterCount - 1 {
      print_to_builder(*b, ", work.f%", it);
   }

   print_to_builder(*b, ");\n");
   print_to_builder(*b, "      };\n");
   print_to_builder(*b, "      header.execute = WorkExecuteFunction;\n");
   print_to_builder(*b, "   }\n\n"); // Work struct done


   print_to_builder(*b, "   work := New(Work,, context.default_allocator);\n");
   print_to_builder(*b, "   work.function = function;\n");

   for 0..parameterCount - 1 {
      print_to_builder(*b, "   work.f%1 = p%1;\n", it);
   }

   print_to_builder(*b, "   return AddWork(*work.header);\n");
   print_to_builder(*b, "}\n");

   return builder_to_string(*b);
}

GenerateDispatchFunctionWithoutThread :: (parameterCount: int) -> string {
   b: String_Builder;
   print_to_builder(*b, "DispatchFunctionWithoutThread :: (function: #type (");

   if (parameterCount > 0) {
      for 0..parameterCount - 2 {
         print_to_builder(*b, "_: $T%, ", it);
      }
      print_to_builder(*b, "_: $T%", parameterCount - 1);
   }

   print_to_builder(*b, ") -> ()");

   for 0..parameterCount - 1 {
      print_to_builder(*b, ", p%1: T%1", it);
   }

   print_to_builder(*b, ") -> WorkHandle {\n");

   print_to_builder(*b,"   Work :: struct {\n");
   print_to_builder(*b,"      header: WorkHeader;\n");
   print_to_builder(*b,"      function: #type (");

   if (parameterCount > 0) {
      for 0..parameterCount - 2 {
         print_to_builder(*b, "T%, ", it);
      }
      print_to_builder(*b, "T%", parameterCount - 1);
   }

   print_to_builder(*b, ") -> ();\n");

   for 0..parameterCount - 1 {
      print_to_builder(*b, "      f%1: T%1;\n", it);
   }

   print_to_builder(*b, "\n");
   print_to_builder(*b, "      WorkExecuteFunction :: (thread: *Thread, header: *WorkHeader) {\n");
   print_to_builder(*b, "         work := cast(*Work) header;\n");
   print_to_builder(*b, "         work.function(");

   if (parameterCount > 0) {
      for 0..parameterCount - 2 {
         print_to_builder(*b, "work.f%, ", it);
      }
      print_to_builder(*b, "work.f%", parameterCount - 1);
   }

   print_to_builder(*b, ");\n");
   print_to_builder(*b, "      };\n");
   print_to_builder(*b, "      header.execute = WorkExecuteFunction;\n");
   print_to_builder(*b, "   }\n\n"); // Work struct done

   print_to_builder(*b, "   work := New(Work,, context.default_allocator);\n");
   print_to_builder(*b, "   work.function = function;\n");

   for 0..parameterCount - 1 {
      print_to_builder(*b, "   work.f%1 = p%1;\n", it);
   }

   print_to_builder(*b, "   return AddWork(*work.header);\n");
   print_to_builder(*b, "}\n");

   return builder_to_string(*b);
}
